# Default
# Homebrew aliases
#
# Every alias below comes in two equivalent forms: brew.<name> and b.<name>.
# Run `brew.help` (or `b.help`) to list them all with descriptions.

_brew_helper() {
  alias_help "${HOME}/.config/aliases/brew"
}

mkalias b brew help '_brew_helper'
mkalias b brew h '_brew_helper'

# Lifecycle
mkalias b brew upgrade 'brew cu --cleanup -f -y && brew update && brew upgrade && brew upgrade --casks && brew cleanup' # full update/upgrade/cleanup sweep
mkalias b brew up 'brew update && brew upgrade' # update & upgrade only
mkalias b brew cu 'brew cu -y' # cask upgrades only
mkalias b brew clean 'brew autoremove && brew cleanup' # autoremove unused deps & clear cache
mkalias b brew doctor 'brew doctor' # run brew's health check
mkalias b brew fix 'cd "$(brew --repository)" && git --git-dir "$(brew --repository)/.git" reset origin/master --hard && git --git-dir "$(brew --repository)/.git" clean -fd' # reset homebrew's own git repo to origin/master

# Repo / navigation
mkalias b brew repo 'cd $(brew --repository)' # cd to homebrew's repository directory

# Bundle / Brewfile management
mkalias b brew dump 'brew bundle dump --file=brew/Brewfile.current --force' # snapshot installed packages to Brewfile.current
mkalias b brew check 'brew bundle check --file=brew/Brewfile.current' # check installed state against Brewfile.current
mkalias b brew install 'brew bundle --file=brew/Brewfile.current' # install packages from Brewfile.current

# Inspection
mkalias b brew leaves 'brew leaves' # installed formulae nothing else depends on
mkalias b brew deps 'brew deps --tree --installed' # dependency tree of installed formulae
mkalias b brew info 'brew info' # + formula/cask name
mkalias b brew casks 'brew list --cask -1' # list installed casks
mkalias b brew formulae 'brew list --formula' # list installed formulae
mkalias b brew outdated 'brew outdated --cask && brew outdated --formula' # list outdated casks & formulae

# Taps
mkalias b brew taps 'brew tap' # list taps
mkalias b brew untap 'brew untap' # + tap name

# Install a fixed set of daily-driver casks
_brew_latest() {
  brew install --cask visual-studio-code
  brew install --cask slack
  brew install --cask rancher
  brew install --cask jetbrains-toolbox
  brew install --cask firefox
  brew install --cask iterm2
  brew install --cask google-chrome
}
mkalias b brew latest '_brew_latest' # install a fixed set of daily-driver casks
