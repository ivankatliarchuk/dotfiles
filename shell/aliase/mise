# Default
# https://mise.jdx.dev
# mise (polyglot runtime/tool version manager) aliases
#
# Every alias below comes in two equivalent forms: mise.<name> and m.<name>.
# Run `mise.help` (or `m.help`) to list them all with descriptions.

_mise_helper() {
  alias_help "${HOME}/.config/aliases/mise"
}
mkalias m mise helper '_mise_helper'
mkalias m mise help 'mise.helper'
mkalias m mise h 'mise.helper'

mkalias m mise use 'mise use' # + tool@version, e.g. m.use go@latest
mkalias m mise use-g 'mise use -g' # set a global tool version
mkalias m mise bootstrap 'mise install' # install versions pinned in config
mkalias m mise ls 'mise ls' # list installed tool versions
mkalias m mise current 'mise current' # active versions in this directory
mkalias m mise ls-remote 'mise ls-remote' # + tool name, e.g. m.ls-remote go
mkalias m mise up 'mise upgrade' # upgrade tools to latest matching version
mkalias m mise doctor 'mise doctor' # diagnose PATH/shim issues
mkalias m mise prune 'mise prune' # remove unused installed versions
