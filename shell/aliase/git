# Git aliases
#
# Every alias below comes in two equivalent forms: git.<name> and g.<name>.
# Run `git.help` (or `g.help`) to list them all with descriptions.

_git_helper() {
  alias_help "${HOME}/.config/aliases/git"
}

mkalias g git help '_git_helper'
mkalias g git h '_git_helper'

