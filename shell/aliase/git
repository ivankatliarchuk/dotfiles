_git_helper() {
  awk '
    /^# / { desc = substr($0, 3); next }
    $0 ~ /^alias git\.|^alias g=/ {
      name = $0
      sub(/^alias /, "", name)
      sub(/=.*/, "", name)
      c = desc
      if (match($0, /# .*/)) c = substr($0, RSTART + 2)
      printf "%-16s %s\n", name, c
      desc = ""
      next
    }
  ' "${HOME}/.config/aliases/git"
}
alias git.helper='_git_helper'
alias git.help='git.helper'
alias git.h='git.helper'

