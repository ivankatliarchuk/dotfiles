_git_pr4ai() {
  local repo="$1" pr="$2"
  [[ -z "$repo" || -z "$pr" ]] && { echo "Usage: $0 REPO PR#"; return 1; }

  # Capture diff, issue comments, review comments using ONLY gh
  local diff=$(gh pr diff "$pr" -R "$repo")
  local issue_comments=$(gh pr view "$pr" -R "$repo" --json comments --jq '.comments[] | {id, body, author: .author.login, createdAt}')
  local review_comments=$(gh api "/repos/$repo/pulls/$pr/comments" --jq '.[] | {id, body, path, line, author: .user.login, createdAt}')

  echo "copied to clipboard"
  {
    echo "=== Diff ==="
    echo "$diff"
    echo
    echo "=== Issue Comments ==="
    echo "$issue_comments"
    echo
    echo "=== Review Comments ==="
    echo "$review_comments"
  } | base64 -w 0 | pbcopy
}

# git.pr4ai kubernetes-sigs/external-dns 6017
alias git.pr4ai='_git_pr4ai' # + repo e.g. ivankatliarchuk/cheatsheet-git + pr number e.g. 123
alias gcf='git commit --all --amend --no-edit' # amend last commit without changing the message'

_git_wt_rm() {
  local name="$1"
  [[ -z "$name" ]] && { echo "Usage: git.wt-rm <name>"; return 1; }

  local wt_path
  wt_path=$(git worktree list | awk -v n="$name" '$0 ~ n { print $1; exit }')
  [[ -z "$wt_path" ]] && { echo "Worktree '$name' not found"; return 1; }

  local branch
  branch=$(git worktree list --porcelain | awk -v p="$wt_path" '
    /^worktree/ { cur=$2 }
    /^branch/ && cur==p { sub("refs/heads/","", $2); print $2; exit }
  ')

  git worktree remove --force "$wt_path"
  [[ -n "$branch" ]] && git branch -D "$branch"
}
alias git.wt-rm='_git_wt_rm' # + worktree name e.g. agent-aacb65e4

_git_wt_clean() {
  local main_wt
  main_wt=$(git worktree list --porcelain | awk '/^worktree/ { print $2; exit }')

  git worktree list --porcelain | awk '/^worktree/ { print $2 }' | while read -r wt_path; do
    [[ "$wt_path" == "$main_wt" ]] && continue
    local branch
    branch=$(git worktree list --porcelain | awk -v p="$wt_path" '
      /^worktree/ { cur=$2 }
      /^branch/ && cur==p { sub("refs/heads/","", $2); print $2; exit }
    ')
    git worktree remove --force "$wt_path"
    [[ -n "$branch" ]] && git branch -D "$branch"
  done
}
alias git.wt-clean='_git_wt_clean' # remove all worktrees and their branches

# print the create/inspect/apply patch workflow steps
alias git.flow.patch='echo "Create & apply a patch:
  1. git diff HEAD > changes.patch    # create patch from current changes
  2. git apply --stat changes.patch   # preview what the patch touches
  3. git apply --check changes.patch  # dry-run validate it applies cleanly
  4. git apply changes.patch          # apply the patch"'
