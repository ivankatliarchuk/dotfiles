# Default
# https://github.com/aws/aws-cli
# https://docs.aws.amazon.com/cli/v1/userguide/cli-configure-files.html
# Universal Command Line Interface for Amazon Web Services
#
# Every alias below comes in two equivalent forms: aws.<name> and a.<name>.
# Run `aws.help` (or `a.help`) to list them all with descriptions.

_aws_helper() {
  alias_help "${HOME}/.config/aliases/aws"
}

mkalias a aws help '_aws_helper'
mkalias a aws h '_aws_helper'

mkalias a aws id "aws sts get-caller-identity" # show caller identity
mkalias a aws whoami "aws.id" # show caller identity
mkalias a aws profiles 'aws configure list-profiles' # list profiles from ~/.aws/credentials & ~/.aws/config

# eks
mkalias a aws eks-kcg 'aws eks update-kubeconfig --name' # + eks cluster name

_eks_oidc_id() {
  # eks cluster oidc id
  aws eks describe-cluster --name "$1" --query "cluster.identity.oidc.issuer" --output text | sed -e "s/^https:\/\///"
}
mkalias a aws eks-oidc '_eks_oidc_id' # + eks cluster name, print its OIDC issuer id

# s3
mkalias a aws s3-ls 'aws s3 ls' # list s3 buckets, or + bucket name to list its objects

# iam
mkalias a aws sts 'aws sts get-caller-identity --output json' # show caller identity (json)
mkalias a aws sts-id 'aws sts get-caller-identity --query "Account" --output text' # show account id
mkalias a aws sts-who 'aws sts get-caller-identity --query "UserId" --output json' # show caller user id
