# Default
# Go aliases
#
# Every alias below is go.<name> only (no short mirror: `g` is git's).
# Run `go.help` to list them all with descriptions.

_go_helper() {
  alias_help "${HOME}/.config/aliases/go"
}

mkalias - go help '_go_helper'
mkalias - go h 'go.helper'

mkalias - go build 'go build ./...' # build all packages
mkalias - go run 'go run .' # run the current package
mkalias - go test 'go test ./...' # run all tests
mkalias - go testv 'go test -v ./...' # run all tests, verbose
mkalias - go cover 'go test -cover ./...' # run tests with coverage
mkalias - go vet 'go vet ./...' # static analysis / suspicious constructs
mkalias - go fmt 'gofmt -l -w .' # format all files in place
mkalias - go tidy 'go mod tidy' # add missing & remove unused modules
mkalias - go deps 'go list -m all' # list all module dependencies
mkalias - go clean 'go clean -cache -testcache' # clear build & test caches
# Install the go.mod-declared version
_go_bootstrap() {
  if [ -n "$1" ]; then
    mise install "$1"
  else
    local v
    v=$(go list -f '{{.GoVersion}}' -m 2>/dev/null)
    if [ -z "$v" ]; then
      echo "go.bootstrap: no go.mod found and no version given" >&2
      return 1
    fi
    mise install "go@${v}"
  fi
}
mkalias - go bootstrap '_go_bootstrap' # install the go.mod-declared version

mkalias - go ratio 'go-ratio.sh' # ratio of lines of code to comments in a Go project
