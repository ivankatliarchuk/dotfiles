# Default
# SSH aliases
#
# Every alias below comes in two equivalent forms: ssh.<name> and s.<name>.
# Run `ssh.help` (or `s.help`) to list them all with descriptions.

_ssh_helper() {
  alias_help "${HOME}/.config/aliases/ssh"
}
mkalias s ssh helper '_ssh_helper'
mkalias s ssh help 'ssh.helper'
mkalias s ssh h 'ssh.helper'

mkalias s ssh config 'cat ~/.ssh/config' # show ssh config
mkalias s ssh edit '$EDITOR ~/.ssh/config' # edit ssh config
mkalias s ssh hosts 'grep "^Host " ~/.ssh/config | grep -v "[?*]" | cut -d " " -f2- | tr " " "\n"' # list configured host aliases, one per line, wildcards excluded
mkalias s ssh cmds 'ssh.hosts | sed "s/^/ssh /"' # print ready-to-run `ssh <host>` commands for every configured host
mkalias s ssh keys 'ls ~/.ssh/*.pub' # list public keys
mkalias s ssh agent 'ssh-add -l' # list keys loaded in the agent
mkalias s ssh keygen 'ssh-keygen -t ed25519 -C "$(whoami)@$(hostname)"' # generate a new key with sane defaults
mkalias s ssh jump 'ssh -J' # + bastion-host target-host (comma-separate bastions to chain jumpboxes)

mkalias s ssh complete '[ -e "$HOME/.ssh/config" ] && complete -o "default" -o "nospace" -W "$(grep "^Host" ~/.ssh/config | grep -v "[?*]" | cut -d " " -f2- | tr " " "\n")" scp sftp ssh' # enable host tab-completion for scp/sftp/ssh (run once per session)
