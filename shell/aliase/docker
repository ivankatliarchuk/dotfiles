# Default
# https://www.docker.com/
# Docker aliases
#
# Every alias below comes in two equivalent forms: docker.<name> and d.<name>.
# Run `docker.help` (or `d.help`) to list them all with descriptions.

_docker_helper() {
  alias_help "${HOME}/.config/aliases/docker"
}
mkalias d docker helper '_docker_helper'
mkalias d docker help 'docker.helper'
mkalias d docker h 'docker.helper'

alias d=docker # shorthand for docker
mkalias d docker rmi docker-rmi # remove a docker image, + image name
mkalias d docker rm 'docker image prune' # remove dangling (untagged) images
mkalias d docker rms 'docker system prune' # remove stopped containers, dangling images, unused networks
mkalias d docker i 'docker images' # list images
mkalias d docker sp 'docker system prune -a' # remove all unused containers, images, networks & volumes

# https://github.com/containers/skopeo
_docker_inspect() {
  skopeo inspect "docker://$1"
}
mkalias d docker inspect '_docker_inspect' # + image path e.g. "docker.inspect registry.fedoraproject.org/fedora:latest"

_docker_list_tags() {
  skopeo list-tags "docker://$1"
}
mkalias d docker list-tags '_docker_list_tags' # + image path e.g. "docker.list-tags registry.k8s.io/git-sync"

_docker_list_tags_digests() {
  local repo="$1"
  skopeo list-tags "docker://$repo" | jq -r '.Tags[]' | while read -r tag; do
    local digest
    digest=$(skopeo inspect "docker://$repo:$tag" --override-os linux --format '{{.Digest}}' 2>/dev/null)
    echo "$tag $digest"
  done
}
mkalias d docker list-tags-digests '_docker_list_tags_digests' # + image path, list every tag with its digest e.g. "docker.list-tags-digests docker.io/library/hello-world"
