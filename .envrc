_keychain() {
  security find-generic-password -s "$1" -a "${2:-$USER}" -w 2>/dev/null
}

# profile from macOS Keychain, default personal
# security add-generic-password -s dotfiles-profile -a "$USER" -w work (add -U to overwrite if it already exists)
export DOTFILES_PROFILE="${DOTFILES_PROFILE:-$(_keychain dotfiles-profile)}"
: "${DOTFILES_PROFILE:=personal}"

case "$DOTFILES_PROFILE" in
  work)     export CLAUDE_VAULT_DIR="${CLAUDE_VAULT_DIR:-$HOME/source/work/knowledgebase}" ;;
  personal) export CLAUDE_VAULT_DIR="${CLAUDE_VAULT_DIR:-$HOME/knowledgebase}" ;;
esac
